SERVICEFLOW_ENV=development
# Comma-separated browser origins. Do not use * when Authorization headers are accepted.
SERVICEFLOW_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SERVICEFLOW_BUSINESS_BASE_URL=http://127.0.0.1:8120
SERVICEFLOW_BUSINESS_TIMEOUT_SECONDS=3
# Total Java GET attempts, including the first request. Only timeout/network/502/503/504 retry.
SERVICEFLOW_BUSINESS_READ_MAX_ATTEMPTS=2
SERVICEFLOW_BUSINESS_READ_INITIAL_BACKOFF_SECONDS=0.1

# Keep disabled until a dedicated ServiceFlow API Key is configured.
SERVICEFLOW_PLANNER_MODEL_ENABLED=false
SERVICEFLOW_TRIAGE_MODEL_ENABLED=false
SERVICEFLOW_KNOWLEDGE_ANSWER_GENERATION_ENABLED=false
# Write-side knowledge ingestion is a high-risk administration action. It is
# closed by default; enable only with a distinct deployment secret, never an LLM key.
SERVICEFLOW_KNOWLEDGE_IMPORT_ENABLED=false
SERVICEFLOW_KNOWLEDGE_IMPORT_ADMIN_TOKEN=replace-with-a-dedicated-long-random-secret
SERVICEFLOW_PLANNER_MODEL_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SERVICEFLOW_PLANNER_MODEL_NAME=qwen3.7-plus
SERVICEFLOW_PLANNER_MODEL_API_KEY_ENV=DASHSCOPE_API_KEY
SERVICEFLOW_PLANNER_MODEL_TIMEOUT_SECONDS=1200
DASHSCOPE_API_KEY=replace-with-your-own-key

# Dense retrieval uses the same secret environment variable, but it is a different
# model capability. Keep this endpoint/model identity explicit and never put it
# in frontend VITE_ variables.
SERVICEFLOW_EMBEDDING_MODEL_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SERVICEFLOW_EMBEDDING_MODEL_NAME=qwen3.7-text-embedding-flash
SERVICEFLOW_EMBEDDING_MODEL_REVISION=qwen3.7-text-embedding-flash-2026-09
SERVICEFLOW_EMBEDDING_MODEL_API_KEY_ENV=DASHSCOPE_API_KEY
SERVICEFLOW_EMBEDDING_MODEL_TIMEOUT_SECONDS=30
SERVICEFLOW_EMBEDDING_MODEL_DIMENSION=1024
SERVICEFLOW_EMBEDDING_MODEL_BATCH_SIZE=20
# Enabling this makes FastAPI prepare/reuse the offline dense index during startup.
# Keep false until the embedding model credentials have passed the dedicated Smoke.
SERVICEFLOW_DENSE_RETRIEVAL_ENABLED=false
SERVICEFLOW_HYBRID_RETRIEVAL_ENABLED=false
SERVICEFLOW_HYBRID_CANDIDATE_K=20
SERVICEFLOW_HYBRID_RANK_CONSTANT=60

# Rerank is optional: it reorders only candidates already returned by Hybrid.
SERVICEFLOW_RERANKER_ENABLED=false
SERVICEFLOW_RERANKER_MODEL_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1
SERVICEFLOW_RERANKER_MODEL_NAME=qwen3-rerank
SERVICEFLOW_RERANKER_MODEL_REVISION=qwen3-rerank-2026-09
SERVICEFLOW_RERANKER_MODEL_API_KEY_ENV=DASHSCOPE_API_KEY
SERVICEFLOW_RERANKER_MODEL_TIMEOUT_SECONDS=30
SERVICEFLOW_RERANKER_CANDIDATE_K=10

# At most one wider retrieval with the same query when initial evidence is insufficient.
SERVICEFLOW_CONTROLLED_SECONDARY_SEARCH_ENABLED=false
SERVICEFLOW_SECONDARY_SEARCH_MINIMUM_EVIDENCE_COUNT=2
SERVICEFLOW_SECONDARY_SEARCH_TOP_K=6
SERVICEFLOW_QUERY_REWRITE_ENABLED=false

# Keep disabled until the selected vision/OCR model is enabled for this API Key.
SERVICEFLOW_OCR_ENABLED=false
SERVICEFLOW_OCR_MODEL_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
SERVICEFLOW_OCR_MODEL_NAME=qwen3.5-ocr
SERVICEFLOW_OCR_MODEL_API_KEY_ENV=DASHSCOPE_API_KEY
SERVICEFLOW_OCR_MODEL_TIMEOUT_SECONDS=60
SERVICEFLOW_OCR_RENDER_DPI=144
SERVICEFLOW_OCR_MAX_PAGE_PIXELS=8000000
